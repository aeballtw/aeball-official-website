

@functions{
    public string TokenValue()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}

<style>
    .icon-pos-absolute {
        position: absolute;
        padding-top: 5px;
        padding-left: 11px;
        z-index: 2;
    }

    span.hint {
        color: red;
        font-size: 14px;
        position: absolute;
    }

    i.password-icon svg.eye-on {
        display: none;
    }

    i.password-icon svg.eye-close {
        display: block;
    }

    i.password-icon.eye-on svg.eye-on {
        display: block;
    }

    i.password-icon.eye-on svg.eye-close {
        display: none;
    }

    @@media (max-width: 992px) {
        #Login_Card {
            box-shadow: none;
        }
    }

</style>

<script>
    const phone_regrex = /^(09\d{8})$/

    $(document).ready(function () {
        $('input').keypress(function (e) {
            var key = window.event ? e.keyCode : e.which;
            if (key == 13)
                Login();
        });
    });

    function Login() {
        if ($('#txt_CuID').val() == '') { alert('請輸入手機號碼！'); return false; }
        if ($('#txt_pwd').val() == '') { alert('請輸入密碼！'); return false; }
        var model = {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            cuID: $('#txt_CuID').val(),
            cuPawd: $('#txt_pwd').val()
        }
        $.ajax({
            url: '@Url.Action("CheckAccount", "Home")',
            type: 'POST',
            dataType: 'json',
            data: model,
            success: function (d) {
                if (d.RetCode == 0) {
                    location.href = '@Url.Action("Index", "Member")'
                } else {
                    customErrorAlert('登入失敗', d.Message);
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function txt_CuID_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入電話號碼！'); return false; }
        if (!phone_regrex.test($(obj).val())) { $(obj).next().html('手機號碼格式不正確！'); return false; }
        var phone = $(obj).val();
        $.ajax({
            url: '@Url.Action("CheckLoginPhone", "Home")',
            type: 'POST',
            dataType: 'json',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                phone: phone
            },
            success: function (d) {
                if (d.RetCode != 0) {
                    $(obj).next().html(d.Message);
                    return false;
                } else {
                    $(obj).next().html('');
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function showPass(obj) {
        $(obj).toggleClass('eye-on');
        if ($(obj).hasClass('eye-on')) {
            $(obj).parent().find('input').prop('type', 'password');
        } else {
            $(obj).parent().find('input').prop('type', 'text');
        }
    }

</script>


