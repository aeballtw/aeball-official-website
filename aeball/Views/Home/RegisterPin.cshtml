
@functions{
    public string TokenValue()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}

<style>
    div.register-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-items: center;
        justify-content: center;
        width: 100px;
    }

        div.register-state div.state {
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid rgba(0, 0, 0, 0.6);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            justify-content: center;
        }

            div.register-state div.state.active {
                background: #ffdec0;
                border: 1px solid #ff7b00;
            }

    input.pin {
        text-align: center;
        width: 43px;
        display: inline-block;
        cursor: pointer;
    }

    span.hint {
        color: red;
        font-size: 14px;
        position: absolute;
    }

    i.password-icon svg.eye-on {
        display: none;
    }

    i.password-icon svg.eye-close {
        display: block;
    }

    i.password-icon.eye-on svg.eye-on {
        display: block;
    }

    i.password-icon.eye-on svg.eye-close {
        display: none;
    }
    
    @@media (max-width: 992px) {
        .dv-pin-input{
            text-align: center;
        }
        .pin-label {
            transform: translateX(-60px);
        }
        span.hint {
            transform: translateX(-140px);
        }
    }


</style>


<script>
    var numReg = /^\d+$/;

    $(document).ready(function () {
        $('input.pin').keyup(function (e) {
            var key = window.event ? e.keyCode : e.which;
            if (key == 8 || key == 46) {
                var input = $(this)[0];
                const prevInput = input.previousElementSibling;

                if (prevInput) {
                    prevInput.focus();
                    prevInput.select();
                }
            }
        });
    });

    function SaveUser() {
        var pin = $('#txt_Pin_1').val() + $('#txt_Pin_2').val() + $('#txt_Pin_3').val() + $('#txt_Pin_4').val() + $('#txt_Pin_5').val() + $('#txt_Pin_6').val();
        var pin2 = $('#txt_chkPin_1').val() + $('#txt_chkPin_2').val() + $('#txt_chkPin_3').val() + $('#txt_chkPin_4').val() + $('#txt_chkPin_5').val() + $('#txt_chkPin_6').val();
        if (pin == '') { alert('請設定 PIN 碼！'); return false; }
        if (pin2 == '') { alert('請再次輸入 PIN 碼！'); return false; }
        if (pin.length != 6) { alert('PIN碼格式錯誤！'); return false; }
        if (pin2.length != 6) { alert('PIN碼格式錯誤！'); return false; }
        if (pin != pin2) { alert('PIN 碼輸入不一致！'); return false; }
        var model = {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            cuPin: pin,
        }
        $.ajax({
            url: '@Url.Action("SavePin", "Home")',
            type: 'POST',
            dataType: 'json',
            data: model,
            success: function (d) {
                if (d.RetCode == 0) {
                    location.href = '@Url.Action("RegisterSuccess", "Home")';
                } else if (d.RetCode == 1) {
                    alert("儲存失敗！" + d.Message);
                    location.href = '@Url.Action("Register", "Home")';
                } else {
                    alert("儲存失敗！" + d.Message);
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function moveToNext(input) {
        // 自動切換到下一個輸入框
        const maxLength = parseInt(input.getAttribute('maxlength'));
        const currentLength = input.value.length;

        if (!numReg.test($(input).val())) {
            $(input).val('');
        }
        else if (currentLength === maxLength) {
            const nextInput = input.nextElementSibling;

            if (nextInput) {
                nextInput.focus();
                if (nextInput.type == 'password') nextInput.select();
            }
        }
    }

    function txt_pin1_onchange(obj) {
        var pin = $('#txt_Pin_1').val() + $('#txt_Pin_2').val() + $('#txt_Pin_3').val() + $('#txt_Pin_4').val() + $('#txt_Pin_5').val() + $('#txt_Pin_6').val();
        if (pin == '') { $(obj).closest('div').find('.hint').html('請設定 PIN 碼！'); return false; }
        else if (pin.length != 6) { $(obj).closest('div').find('.hint').html('PIN碼格式錯誤！'); return false; }
        else { $(obj).closest('div').find('.hint').html(''); return false; }
    }

    function txt_pin_onchange(obj) {
        var pin = $('#txt_Pin_1').val() + $('#txt_Pin_2').val() + $('#txt_Pin_3').val() + $('#txt_Pin_4').val() + $('#txt_Pin_5').val() + $('#txt_Pin_6').val();
        var pin2 = $('#txt_chkPin_1').val() + $('#txt_chkPin_2').val() + $('#txt_chkPin_3').val() + $('#txt_chkPin_4').val() + $('#txt_chkPin_5').val() + $('#txt_chkPin_6').val();
        if (pin.length != 6) { $(obj).closest('div').find('.hint').html('PIN碼格式錯誤！'); return false; }
        else if (pin != pin2) { $(obj).closest('div').find('.hint').html('再次輸入PIN碼與設定不同！'); return false; }
        else { $(obj).closest('div').find('.hint').html(''); return false; }
    }

    function showPass(obj) {
        $(obj).toggleClass('eye-on');
        if ($(obj).hasClass('eye-on')) {
            $(obj).closest('.pin-row').find('input').prop('type', 'password');
        } else {
            $(obj).closest('.pin-row').find('input').prop('type', 'text');
        }
    }

</script>

