<style>
    .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        transform: translateY(20px);
    }

    .open-24h {
        margin-left: 8px;
        padding: 2px 8px;
        font-size: 14px;
        font-weight: 600;
        color: #2E7D32;
        background-color: #E8F5E9;
        border-radius: 12px;
    }
</style>

<script>

    function Toggle_placeTime(obj) {
        if ($(obj).find('i').hasClass('fa-angle-down')) {
            $(obj).find('i').removeClass('fa-angle-down');
            $(obj).find('i').addClass('fa-angle-up');
            $(obj).parent().find('div.place_time').show();
        } else {
            $(obj).find('i').removeClass('fa-angle-up');
            $(obj).find('i').addClass('fa-angle-down');
            $(obj).parent().find('div.place_time').hide();
        }
    }

</script>

