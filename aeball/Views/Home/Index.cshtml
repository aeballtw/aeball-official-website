    @*var BasketBallIndex = 0;*@

        $(document).ready(function () {
            $('#dv_basketball').slick({
                centerMode: true,
                arrows: false,
                slidesToShow: 5,
                focusOnSelect: true,
                swipeToSlide: true,
                responsive: [
                    {
                        breakpoint: 992,
                        settings: {
                            arrows: false,
                            centerMode: true,
                            centerPadding: '50px',
                            slidesToShow: 3
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            arrows: false,
                            centerMode: true,
                            centerPadding: '20px',
                            slidesToShow: 1
                        }
                    }
                ]
            });

            $('#dv_basketball').on('afterChange', function (event, slick, currentSlide) {
                $('#basketball_info .title').html(basketballInfo[currentSlide].title);
                $('#basketball_info .content').html(basketballInfo[currentSlide].content);
                $('#basketball_info .price').html('<span style="font-size:24px;">' + basketballInfo[currentSlide].price + '</span><span style="font-size:14px;"> 元 / 0.5小時</span>');
            })

            $("#poster-borrow-swithed > div").mouseover(function () {
                poster_borrow_interval = false;
                poster_borrow_index = $(this).data('index');
                showPoster(this, poster_borrow_index);
            });

            $("#poster-borrow-swithed > div").mouseout(function () {
                poster_borrow_interval = true;
            });

            $("#poster-return-swithed > div").mouseover(function () {
                poster_return_interval = false;
                poster_return_index = $(this).data('index');
                showPoster(this, poster_return_index);
            });

            $("#poster-return-swithed > div").mouseout(function () {
                poster_return_interval = true;
            });

            setInterval(
                function () {
                    if (poster_borrow_interval) { poster_borrow_index = (poster_borrow_index + 1) % 4; showPoster($('#poster-borrow-swithed > div.active'), poster_borrow_index) };
                    if (poster_return_interval) { poster_return_index = (poster_return_index + 1) % 4; showPoster($('#poster-return-swithed > div.active'), poster_return_index) };
                }, 4000);
        });

    @*function BasketBallSwitch(num) {
        BasketBallIndex = (BasketBallIndex + num + basketballInfo.length) % basketballInfo.length;
        $('#dv_basketball div:eq(0) img').attr('src', basketballInfo[(BasketBallIndex - 2 + basketballInfo.length) % basketballInfo.length].src);
        $('#dv_basketball div:eq(1) img').attr('src', basketballInfo[(BasketBallIndex - 1 + basketballInfo.length) % basketballInfo.length].src);
        $('#dv_basketball div:eq(2) img').attr('src', basketballInfo[(BasketBallIndex + basketballInfo.length) % basketballInfo.length].src);
        $('#dv_basketball div:eq(3) img').attr('src', basketballInfo[(BasketBallIndex + 1) % basketballInfo.length].src);
        $('#dv_basketball div:eq(4) img').attr('src', basketballInfo[(BasketBallIndex + 2) % basketballInfo.length].src);

        $('#basketball_info .title').html(basketballInfo[BasketBallIndex].title);
        $('#basketball_info .content').html(basketballInfo[BasketBallIndex].content);
        $('#basketball_info .price').html('<span style="font-size:24px;">' + basketballInfo[BasketBallIndex].price + '</span><span style="font-size:14px;"> 元 / 0.5小時</span>');
    }*@

    function showPoster(obj, index) {
        var $head = $(obj).closest('.poster-switched');
        $head.find('div.active').removeClass('active');
        $head.find('div.dv-step:eq(' + index + ')').addClass('active');
        $head.find('div.dv-step').removeClass('step-progress');
        for (var i = 0; i < index; i++) {
            $head.find('div.dv-step:eq(' + i + ')').addClass('step-progress');
        }
        $head.closest('div.row').find('div.pic img').removeClass('active');
        $head.closest('div.row').find('div.pic img:eq(' + index + ')').addClass('active');
    }

</script>

