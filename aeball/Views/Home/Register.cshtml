@model Comlib.SysUser
@functions{
    public string TokenValue()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}

<style>

    .icon-pos-absolute {
        position: absolute;
        padding-top: 5px;
        padding-left: 11px;
        z-index: 2;
    }

    div.register-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-items: center;
        justify-content: center;
        width: 100px;
    }

        div.register-state div.state {
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid rgba(0, 0, 0, 0.6);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            justify-content: center;
        }

            div.register-state div.state.active {
                background: #ffdec0;
                border: 1px solid #ff7b00;
            }

    span.hint {
        color: red;
        font-size: 14px;
        position: absolute;
    }

    i.password-icon svg.eye-on {
        display: none;
    }

    i.password-icon svg.eye-close {
        display: block;
    }

    i.password-icon.eye-on svg.eye-on {
        display: block;
    }

    i.password-icon.eye-on svg.eye-close {
        display: none;
    }

</style>

<script>
    const regrex = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,18}$/
    const phone_regrex = /^(09\d{8})$/
    var sendCntdownTime = null;

    $(document).ready(function () {
        setInterval(
            function () {
                if (sendCntdownTime != null && new Date().getTime() - sendCntdownTime < 60000) {
                    $('#btn-sendVerifyCode').html((60 - parseInt((new Date().getTime() - sendCntdownTime) / 1000)) + '秒');
                    $('#btn-sendVerifyCode').prop('disabled', true);
                } else {
                    $('#btn-sendVerifyCode').html('發送驗證碼');
                    $('#btn-sendVerifyCode').prop('disabled', false);
                }
            }, 1000);
    });

    function SavePhone() {
        if ($('#txt_CuTel').val() == '') { alert('請輸入電話號碼！'); return false; }
        if ($('#txt_ValidPhone').val() == '') { alert('請輸入簡訊驗證碼！'); return false; }
        if ($('#txt_pwd').val() == '') { alert('請輸入密碼！'); return false; }
        if (!regrex.test($('#txt_pwd').val())) { alert('密碼長度必須是6-18位，含大小寫英文及數字！'); return false; }
        if ($('#txt_pwd').val() != $('#txt_pwd2').val()) { alert('確認密碼與密碼不同！'); return false; }
        if (!$('#chk_Confirm').prop('checked')) { alert('請閱讀會員條款及隱私權政策！'); return false; }
        var model = {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            cuTel: $('#txt_CuTel').val(),
            VerifyCode: $('#txt_ValidPhone').val(),
            cuPawd: $('#txt_pwd').val()
        }
        $.ajax({
            url: '@Url.Action("SavePhone", "Home")',
            type: 'POST',
            dataType: 'json',
            data: model,
            success: function (d) {
                if (d.RetCode == 0) {
                    location.href = '@Url.Action("RegisterUser", "Home")';
                } else {
                    alert("儲存失敗！" + d.Message);
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function VerifyPhone() {
        if ($('#txt_CuTel').val() == '') { alert('請輸入電話號碼！'); return false; }
        var phone = $('#txt_CuTel').val();
        $.ajax({
            url: '@Url.Action("VerifyPhone", "Home")',
            type: 'POST',
            dataType: 'json',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                phone: phone
            },
            success: function (d) {
                if (d.RetCode == 0) {
                    sendCntdownTime = new Date().getTime();
                    $('btn-sendVerifyCode').html('60秒');
                    $('btn-sendVerifyCode').prop('disabled', true);
                    //if (d.Message)alert(d.Message);
                } else {
                    alert("簡訊發送失敗！" + d.Message);
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function txt_CuTel_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入電話號碼！'); return false; }
        if (!phone_regrex.test($(obj).val())) { $(obj).next().html('手機號碼格式不正確！'); return false; }
        var phone = $('#txt_CuTel').val();
        $.ajax({
            url: '@Url.Action("CheckPhone", "Home")',
            type: 'POST',
            dataType: 'json',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                phone: phone
            },
            success: function (d) {
                if (d.RetCode != 0) {
                    $(obj).next().html(d.Message);
                    return false;
                } else {
                    $(obj).next().html('');
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function txt_VerifyCode_onchange(obj) {
        if ($(obj).val() == '') { $(obj).parent().find('.hint').html('請輸入簡訊驗證碼！'); return false; }
        $.ajax({
            url: '@Url.Action("CheckVerifyCode", "Home")',
            type: 'POST',
            dataType: 'json',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                code: $(obj).val()
            },
            success: function (d) {
                if (d.RetCode != 0) {
                    $(obj).parent().find('.hint').html(d.Message);
                    return false;
                } else {
                    $(obj).parent().find('.hint').html('');
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function txt_pwd_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入密碼！'); return false; }
        else if (!regrex.test($(obj).val())) { $(obj).next().html('密碼格式不正確！'); return false; }
        else {
            $(obj).next().html('');
            if ($('#txt_pwd2').val() != '') txt_pwd2_onchange($('#txt_pwd2'));
            return true;
        }
    }

    function txt_pwd2_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入確認密碼！'); return false; }
        else if ($(obj).val() != $('#txt_pwd').val()) { $(obj).next().html('確認密碼與密碼不同！'); return false; }
        else { $(obj).next().html(''); return true; }
    }

    function chk_Confirm_onchange(obj) {
        if ($(obj).prop('checked')) {
            $('#btn_nextstep').prop('disabled', false);
        } else {
            $('#btn_nextstep').prop('disabled', true);
        }
    }

    function showPass(obj) {
        $(obj).toggleClass('eye-on');
        if ($(obj).hasClass('eye-on')) {
            $(obj).parent().find('input').prop('type', 'password');
        } else {
            $(obj).parent().find('input').prop('type', 'text');
        }
    }

</script>

