    <script>
        var timeCount = 0;
        var webroot = '@Url.Content("~/")';

        $(document).ready(function () {
            AOS.init();
            @if (SysApp.CurrUser != null && !string.IsNullOrEmpty(SysApp.CurrUser.cuID))
            {<text>
                ChkSTime();
            </text>}
            $('#navbarNav + div').click(function () {
                closeNavMenu();
            })
            $(document).ajaxError(function myErrorHandler(xhr, props) {
                if (props.status === 501) {
                    alert("登入逾時!");
                    location.href = '@Url.Action("Login", "Home")';
                }
            });
        });

        function ChkSTime() {
            timeCount++;
            if (timeCount == 300) {//5分鐘延長一次session
                RefillSession();
            }
            else {
                window.setTimeout(ChkSTime, 1000);
            }
        }

        function RefillSession() {
            $.ajax({
                type: 'POST',
                url: '@Url.Content("~/Common/RefillSession")',
                async: true,
                success: function (obj) {
                    if (obj == "1") {
                        timeCount = 0;
                        ChkSTime();
                    }
                    else {
                        window.setTimeout(ChkSTime, 1000);
                    }
                }
            })
        }

        function closeNavMenu() {
            $('.navbar-collapse').collapse('hide');
        }

        function ScrollToTop() {
            $("body").animate({ scrollTop: 0 }, "slow");
            return false;
        }

        function customAlert(title, fun) {
            Swal.fire({
                title: title,
                icon: "success",
                width: 224,
                confirmButtonColor: "#ff7b02",
            }).then((result) => {
                if (result.isConfirmed && fun) {
                    fun();
                }
            });
        }

        function customConfirm(title, content, fun) {
            Swal.fire({
                title: title,
                text: content,
                icon: "warning",
                width: 312,
                color: "#fff",
                showCancelButton: true,
                confirmButtonText: "暫時略過",
                cancelButtonText: "繼續填寫",
                confirmButtonColor: "#2e2c2d",
                cancelButtonColor: "#ff7b02",
            }).then((result) => {
                if (result.isConfirmed && fun) {
                    fun();
                }
            });
        }

        function customErrorAlert(title, content) {
            Swal.fire({
                title: title,
                text: content,
                icon: "error",
                width: 224,
                color: "#fff",
                timer: 2000,
                confirmButtonColor: "#ff7b02",
            });
        }
    </script>
