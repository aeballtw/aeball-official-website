@model Comlib.SysUser
@functions{
    public string TokenValue()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}

<style>

    span.hint {
        color: red;
        font-size: 14px;
        position: absolute;
    }

</style>

<script>
    var emailRule = @("/^\\w+((-\\w+)|(\\.\\w+))*\\@[A-Za-z0-9]+((\\.|-)[A-Za-z0-9]+)*\\.[A-Za-z]+$/");

    $(document).ready(function () {
        sel_City_onchange();
    });

    function txt_CuName_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('姓名為必填欄位！'); return false; }
        else { $(obj).next().html(''); return true; }
    }

    function sel_City_onchange() {
        var temp = $('#sel_Town').val();
        debugger;
        if ($('#sel_City').val() == '') {
            //$('#sel_Town option').hide();
            //$('#sel_Town option:eq(0)').show();
            //$('#sel_Town').val('');
            $('#sel_Town').html('<option value="">請選擇</option>');
        } else {
            $('#sel_Town').html('');
            $('#sel_Town').html($('#sel_temp_Town').html());
            $('#sel_Town option').each(function(){
                if ($(this).data('city') != $('#sel_City').val() && $(this).val() != '') $(this).remove();
            })
            if ($('#sel_Town option[value=' + temp + ']').length != 0) $('#sel_Town').val(temp);
            else $('#sel_Town').val('');
            //$('#sel_Town option').hide();
            //$('#sel_Town option[data-city=' + $('#sel_City').val() + ']').show();
            //$('#sel_Town option:eq(0)').show();
            //if ($('#sel_Town').val() != '') {
            //    if ($('#sel_Town option[value=' + temp + ']').data('city') != $('#sel_City').val())
            //        $('#sel_Town').val('');
            //}
        }
    }

    function SaveUser() {
        if ($('#txt_CuName').val() == '') { alert('請輸入姓名！'); return false; }
        if ($('#txt_Date').val() != '' && Date.parse($('#txt_Date').val()) > Date.now()) { alert('出生日期不正確！'); return false; }
        @if (Model.cuCity!=0){<text>if ($('#sel_City').val()=='') { alert('請選擇行政區！'); return false; }</text>}
        @if (Model.cuTown!=0){<text>if ($('#sel_Town').val() == '') { alert('請選擇鄉鎮市區！'); return false; }</text>}
        @if (!string.IsNullOrEmpty(Model.cuArea)){<text>if ($('#txt_CuArea').val()=='') { alert('請輸入地址！'); return false; }</text>}
        @if (!string.IsNullOrEmpty(Model.cuMail)){<text>if ($('#txt_CuMail').val() == '') { alert('請輸入電子信箱！'); return false; }</text>}
        if ($('#txt_CuMail').val()!='' && !emailRule.test($('#txt_CuMail').val())) { alert('電子信箱格式不正確！'); return false; }
        var model = {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            cuName: $('#txt_CuName').val(),
            cuGender: $('input[name=CuGender]:checked').val(),
            cuCity: $('#sel_City').val(),
            cuTown: $('#sel_Town').val(),
            cuArea: $('#txt_CuArea').val(),
            cuMail: $('#txt_CuMail').val(),
            cuBirthday: $('#txt_Date').val()
        }
        $.ajax({
            url: '@Url.Action("SaveUser", "Member")',
            type: 'POST',
            dataType: 'json',
            data: model,
            success: function (d) {
                if (d.RetCode == 0) {
                    customAlert("已儲存會員資料", function () { location.href = '@Url.Action("Index", "Member")'; });
                } else {
                    alert("儲存失敗！" + d.Message);
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function txt_Date_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html(''); return false; }
        else if ($('#txt_Date').val() != '' && Date.parse($('#txt_Date').val()) > Date.now()) { $(obj).next().html('出生日期不正確！'); return false; }
        else $(obj).next().html('');
    }

    function txt_CuMail_onchange(obj) {
        @if (!string.IsNullOrEmpty(Model.cuMail)){<text>if ($('#txt_CuMail').val() == '') { $(obj).next().html('請輸入電子信箱！'); return false; } else</text>}
        if ($(obj).val() == '') { $(obj).next().html(''); return false; }
        else if (!emailRule.test($(obj).val())) { $(obj).next().html('電子信箱格式不正確！'); return false; }
        else $(obj).next().html('');
    }


</script>

@*加入會員*@
<div class="container body-content">
    <section style="margin: auto; margin-top: 150px; margin-bottom: 100px; padding-top: 50px; padding-bottom: 50px; max-width: 600px; ">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <div class="text-center">
                        <h2 style="margin-top:10px;">編輯會員資料</h2>
                    </div>
                </div>
            </div>

            @Html.AntiForgeryToken()
            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <label class="control-label col-lg-7" style="text-align: left;">
                            姓名
                            <span style="color: red; font-weight: 400; padding-left: 10px;font-size: 14px;">*必填</span>
                        </label>
                        <div class="col-lg-7 control-label">
                            <input class="input-group form-control" id="txt_CuName" value="@Model.cuName" placeholder="請輸入姓名" onchange="txt_CuName_onchange(this)">
                            <span class="hint"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <label class="control-label col-lg-7" style="text-align: left;">手機號碼<span style="color: #FF7B00; font-weight: 400; float: right; ">帳號無法修改</span></label>
                        <div class="col-lg-7 control-label">
                            <input class="input-group form-control" id="txt_CuName" value="@Model.cuTel" disabled>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <label class="control-label col-lg-7" style="text-align: left;">出生日期<span style="color: #FF7B00; font-weight: 400; float: right; ">送出後無法修改</span></label>
                        <div class="col-lg-7 control-label">
                            <input type="date" class="form-control" id="txt_Date" onfocus="this.showPicker()" onchange="txt_Date_onchange(this)" value="@Model.cuBirthday" max="@DateTime.Now.ToString("yyyy-MM-dd")" @(string.IsNullOrEmpty(Model.cuBirthday) ? "" : "disabled")>
                            <span class="hint"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <label class="control-label col-lg-7" style="text-align: left;">性別</label>
                        <div class="col-lg-7">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="CuGender" id="CuGender_1" value="1" @(Model.cuGender == "1" ? "checked" : "") )>
                                <label class="form-check-label" for="CuGender_1">男生</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="CuGender" id="CuGender_0" value="0" @(Model.cuGender == "0" ? "checked" : "")>
                                <label class="form-check-label" for="CuGender_0">女生</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="CuGender" id="CuGender_2" value="2" @(Model.cuGender == "2" ? "checked" : "")>
                                <label class="form-check-label" for="CuGender_2">其他</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <label class="control-label col-lg-7" style="text-align: left;">
                            通訊地址
                            @if (Model.cuCity!=0|| Model.cuTown!=0||!string.IsNullOrEmpty(Model.cuArea))
                            { 
                                <span style="color: red; font-weight: 400; padding-left: 10px;font-size: 14px;">*必填</span>
                            }
                        </label>
                        <div class="col-lg-7">
                            @RenderPage("~/Views/Shared/_ComDdl.cshtml", new { id = "sel_City", type = "City", style = "width: calc(50% - 5px); float: left;", onchange = "sel_City_onchange()", val = Model.cuCity })
                            @RenderPage("~/Views/Shared/_ComDdl.cshtml", new { id = "sel_Town", type = "Town", style = "width: calc(50% - 5px); float: right;", val = Model.cuTown })
                            <div class="clearfix" style="margin-bottom: 10px; "></div>
                            <input class="input-group form-control" id="txt_CuArea" value="@Model.cuArea" placeholder="請輸入地址">
                        </div>
                    </div>
                </div>
            </div>
            <div style="display: none">@RenderPage("~/Views/Shared/_ComDdl.cshtml", new { id = "sel_temp_Town", type = "Town", style = "width: calc(50% - 5px); float: right;" })</div>
            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <label class="control-label col-lg-7" style="text-align: left;">
                            電子信箱
                            @if (!string.IsNullOrEmpty(Model.cuMail))
                            {
                                <span style="color: red; font-weight: 400; padding-left: 10px;font-size: 14px;">*必填</span>
                            }
                        </label>
                        <div class="col-lg-7">
                            <input class="input-group form-control" id="txt_CuMail" value="@Model.cuMail" placeholder="example@mail.com" onchange="txt_CuMail_onchange(this)">
                            <span class="hint"></span>
                            <div style="height: 12px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <div class="row" style="justify-content: center;">
                        <div class="col-lg-7" style="display: flex; justify-content: center;">
                            <button type="button" class="btn btn-primary Button-lg" style="min-width: 100px; width: 45%; margin-right: 5%; background: #2e2c2c; border: 1px solid #2e2c2c " onclick="location.href='@Url.Action("Index", "Member")'">取消</button>
                            <button type="button" class="btn btn-primary Button-lg" style="min-width: 100px; width: 45%; margin-left: 5%;" onclick="SaveUser()">完成</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>




