@model Comlib.SysUser
@{
    ViewBag.Title = "ModifyPwd";
}

<style>

    .nav-link > div {
        float: left;
        cursor: pointer;
        font-weight: 400;
    }

    li.user-menu:hover div.user-menu-item, li.user-menu:hover div.user-menu-item svg path {
        color: #ff7b00 !important;
        fill: #ff7b00 !important;
    }

    ul.user-menu.navbar-nav li.nav-item {
        margin: 0px;
        width: 100%;
    }

        ul.user-menu.navbar-nav li.nav-item a.nav-link {
            margin-left: 10px;
        }

    ul.user-menu.navbar-nav li.nav-item {
        display: flex;
        justify-content: center;
        padding: 0px 0px;
        overflow: hidden;
    }

        ul.user-menu.navbar-nav li.nav-item a {
            margin-left: 5px;
        }

        ul.user-menu.navbar-nav li.nav-item.active a {
            margin-left: 0px;
        }

        ul.user-menu.navbar-nav li.nav-item.active {
            border-left: 5px solid #ff7b00;
            margin-left: 0px;
        }

    span.hint {
        color: red;
        font-size: 14px;
        position: absolute;
    }

    i.password-icon svg.eye-on {
        display: none;
    }

    i.password-icon svg.eye-close {
        display: block;
    }

    i.password-icon.eye-on svg.eye-on {
        display: block;
    }

    i.password-icon.eye-on svg.eye-close {
        display: none;
    }

    @@media (max-width: 992px) {
        label .control-label {
            text-align: right;
            width: 150px;
        }

        div.control-label {
            width: calc(100% - 150px);
        }
    }
</style>

<script>
    const regrex = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,18}$/

    function SavePwd() {
        if ($('#txt_old_pwd').val() == '') { alert('請輸入舊密碼！'); return false; }
        if ($('#txt_pwd').val() == '') { alert('請輸入密碼！'); return false; }
        if (!regrex.test($('#txt_pwd').val())) { alert('密碼長度必須是6-18位，含大小寫英數字！'); return false; }
        if ($('#txt_pwd').val() != $('#txt_pwd2').val()) { alert('確認密碼與密碼不符！'); return false; } 
        var model = {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            cuPawd: $('#txt_pwd').val(),
            OldPwd: $('#txt_old_pwd').val(),
        }
        $.ajax({
            url: '@Url.Action("SavePwd", "Member")',
            type: 'POST',
            dataType: 'json',
            data: model,
            success: function (d) {
                if (d.RetCode == 0) {
                    customAlert("已儲存新密碼請重新登入", function () { location.href = '@Url.Action("Logout", "Home")'; });
                } else {
                    customErrorAlert(d.Message);
                }
            },
            error: function (e) {
                alert("取得錯誤");
            }
        });
    }

    function showPass(obj) {
        $(obj).toggleClass('eye-on');
        if ($(obj).hasClass('eye-on')) {
            $(obj).parent().find('input').prop('type', 'password');
        } else {
            $(obj).parent().find('input').prop('type', 'text');
        }
    }

    function txt_old_pwd_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入舊密碼！'); return false; }
        else $(obj).next().html('');
    }

    function txt_pwd_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入密碼！'); return false; }
        else if (!regrex.test($(obj).val())) { $(obj).next().html('密碼格式不正確！'); return false; }
        else {
            $(obj).next().html('');
            if ($('#txt_pwd2').val() != '') txt_pwd2_onchange($('#txt_pwd2'));
            return true;
        }
    }

    function txt_pwd2_onchange(obj) {
        if ($(obj).val() == '') { $(obj).next().html('請輸入確認密碼！'); return false; }
        else if ($(obj).val() != $('#txt_pwd').val()) { $(obj).next().html('確認密碼與密碼不同！'); return false; }
        else { $(obj).next().html(''); return true; }
    }
</script>

