<style>
    #dv_FAQ p.Caption {
        font-size: 16px;
        opacity: 0.6;
    }

    #dv_FAQ div.dv_question {
        padding: 10px 10px;
        margin: 0px 50px;
        cursor: pointer;
        position: relative;
    }

