        }

    #dv_FAQ .fa-solid {
        position: absolute;
        right: -5px;
        top: 18px;
        color: #ff7b00;
    }

    #dv_FAQ div.dv_question:nth-child(1) .fa-solid {
        top: 23px;
    }

    @@media (max-width: 992px) {
