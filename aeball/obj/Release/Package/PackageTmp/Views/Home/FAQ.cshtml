            }

        #dv_FAQ div.dv_question h4 {
            font-size: 18px;
        }
    }

</style>

<script>

    function Toggle_div(obj) {
        if ($(obj).find('i').hasClass('fa-angle-down')) {
            $(obj).find('i').removeClass('fa-angle-down');
            $(obj).find('i').addClass('fa-angle-up');
            $(obj).parent().find('p.toggle-Content').show('fast');
        } else {
            $(obj).find('i').removeClass('fa-angle-up');
            $(obj).find('i').addClass('fa-angle-down');
            $(obj).parent().find('p.toggle-Content').hide('fast');
        }
    }

</script>

